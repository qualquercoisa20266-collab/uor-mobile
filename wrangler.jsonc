{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "war-mapa",
  "main": "./src/index.js",
  "compatibility_date": "2026-09-23",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/ws/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "uor_accounts",
      "database_id": "5aa310ac-7ec7-4716-9d67-c183c5e4e1bf",
      "migrations_dir": "./migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "UOR_ROOM", "class_name": "UORRoom" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["UORRoom"]
    }
  ]
}
